<article class="teaser practical-information-teaser shadow position-relative">
  <a href="{{ link }}" class="d-block text-decoration-none">
    <div class="teaser__content practical-information-teaser-text-content p-3">
      <div class="text-primary fw-bold text-uppercase h6">{{ category }}</div>
      <h4 class="h5">{{ title }}</h4>
      <div class="mb-3">{{ summary }}</div>
      <div class="btn btn-primary stretched-link">{{ 'More information'|t }}</div>
    </div>
  </a>
</article>
